# build-time only. never expose these values to browser code
OPENAI_API_KEY=
OPENAI_EXAMPLE_MODEL=
OPENAI_REVIEW_MODEL=
# optional loopback-only OpenAI-compatible endpoint such as LM Studio
OPENAI_BASE_URL=

FORVO_API_KEY=
FORVO_LICENSE_REFERENCE=
FORVO_ALLOW_STATIC_REDISTRIBUTION=false

GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_VOICE=fr-FR-Neural2-F
GOOGLE_TTS_LICENSE_REFERENCE=

# public build setting. this is not a secret
VITE_BASE_PATH=/french-1000/
