# local source workbooks and generated media should not enter a commit by accident
data/raw/*
!data/raw/.gitkeep
data/local/

# licensed release-ready audio is tracked after validation

# credentials used only by the build-time content pipeline
.env
.env.*
!.env.example

# future node and test outputs
node_modules/
dist/
coverage/
playwright-report/
test-results/
.vite/
*.tsbuildinfo

# editor and macOS files
.DS_Store
.idea/
.vscode/
